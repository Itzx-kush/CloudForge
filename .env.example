# ==============================================================================
# CloudForge Local Development Environment Configuration (Phase 2)
# ==============================================================================
# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# WARNING: Never commit ".env", private keys (*.pem), or real OAuth/webhook
# secrets to Git. See docs/GITHUB_INTEGRATION.md for full GitHub setup steps.
# ==============================================================================

# --- PostgreSQL 17 (Docker Compose) ---
POSTGRES_DB=cloudforge
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=cloudforge_local_dev_password
POSTGRES_PORT=5432

# --- Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
SPRING_FLYWAY_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLOUDFORGE_FRONTEND_BASE_URL=http://localhost:5173
CLOUDFORGE_ALLOWED_REDIRECT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLOUDFORGE_COOKIE_SECURE=false
CLOUDFORGE_COOKIE_SAME_SITE=lax
CLOUDFORGE_SESSION_TIMEOUT=8h
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- GitHub OAuth App (User Identity Login — scopes: read:user, user:email) ---
# Callback URL to register in GitHub OAuth App settings:
#   http://localhost:5173/login/oauth2/code/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# --- GitHub App (Least-Privilege Repository Access & Webhooks) ---
# Setup URL / Callback URL to register in GitHub App settings:
#   http://localhost:5173/api/github/app/callback
# Provide EITHER GITHUB_APP_PRIVATE_KEY (PEM with \n newlines) OR GITHUB_APP_PRIVATE_KEY_PATH
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_APP_CALLBACK_URL=http://localhost:5173/api/github/app/callback

# --- React / Vite Frontend ---
VITE_API_PROXY_TARGET=http://localhost:8080

# --- Phase 3.3 Isolated Worker Control Plane (Opt-In Local Development Only) ---
# Disabled by default and always disabled in Render staging.
# Provision per-worker secrets strictly via local environment (never commit real secrets).
# Format: workerId:keyId:secret[:expiresAtIso],... (secret must be >= 16 chars)
CLOUDFORGE_WORKERS_ENABLED=false
CLOUDFORGE_WORKERS_SCHEDULER_ENABLED=false
CLOUDFORGE_WORKER_CREDENTIALS=

# --- Phase 3.3 Host-Side Isolated Worker Agent (run via worker/target/cloudforge-worker.jar) ---
# Never grant Docker socket access to the Spring Boot control plane or untrusted execution containers.
CLOUDFORGE_CONTROL_PLANE_URL=http://127.0.0.1:8080
CLOUDFORGE_WORKER_ID=local-docker-worker-1
CLOUDFORGE_WORKER_TOKEN=
CLOUDFORGE_EXECUTOR_IMAGE=alpine:3.20
CLOUDFORGE_EXECUTOR_CPU_LIMIT=0.5
CLOUDFORGE_EXECUTOR_MEMORY_LIMIT=128m
CLOUDFORGE_EXECUTOR_PIDS_LIMIT=64

# --- Phase 3.4 Encrypted Secret Management & Worker Delivery (Fail-Closed Defaults) ---
# Generate local 256-bit Base64 AES keys with: openssl rand -base64 32
# Never commit real keys or enable insecure local delivery outside loopback development.
CLOUDFORGE_SECRETS_ENABLED=false
CLOUDFORGE_SECRETS_KEY_PROVIDER=env-keyring
CLOUDFORGE_SECRETS_ACTIVE_KEY_ID=
CLOUDFORGE_SECRETS_KEYRING=
CLOUDFORGE_SECRETS_WORKER_DELIVERY_ENABLED=false
CLOUDFORGE_SECRETS_ALLOW_INSECURE_LOCAL_DELIVERY=false
CLOUDFORGE_SECRETS_MAX_DELIVERIES_PER_ATTEMPT=2
CLOUDFORGE_SECRETS_DENIED_AUDIT_COOLDOWN_SECONDS=10
CLOUDFORGE_SECRETS_OPERATOR_ROTATION_ENABLED=false
CLOUDFORGE_SECRETS_OPERATOR_ROTATION_TOKEN=
CLOUDFORGE_WORKER_SECRET_DELIVERY_ENABLED=false
CLOUDFORGE_WORKER_ALLOW_INSECURE_LOCAL_DELIVERY=false
