# ==============================================================================
# CloudForge Local Development Environment Configuration
# ==============================================================================
# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# WARNING: These example values are strictly for LOCAL DEVELOPMENT ONLY.
# Never commit ".env" to Git and never reuse local values in production.
# ==============================================================================

# --- PostgreSQL 17 (Docker Compose) ---
POSTGRES_DB=cloudforge
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=cloudforge_local_dev_password
POSTGRES_PORT=5432

# --- Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- React / Vite Frontend ---
VITE_API_PROXY_TARGET=http://localhost:8080
