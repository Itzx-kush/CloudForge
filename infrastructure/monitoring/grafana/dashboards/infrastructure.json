{
  "uid": "cf-infrastructure",
  "title": "CloudForge Infrastructure",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "JVM memory bytes",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudforge"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (area) (jvm_memory_used_bytes)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Database available",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudforge"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Active connections",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudforge"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Last worker heartbeat age",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudforge"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - cloudforge_worker_last_heartbeat_seconds"
        }
      ]
    }
  ]
}
