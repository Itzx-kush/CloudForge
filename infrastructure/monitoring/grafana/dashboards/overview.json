{
  "uid": "cf-overview",
  "title": "CloudForge Overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API availability",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudforge"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"backend\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudforge"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API p95 seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudforge"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
